{
  "latex-workshop.latex.tools": [
    {
      "name": "Docker via Makefile",
      "command": "make",
      "args": [
        "build"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "Compilar Projeto (Make + Docker)",
      "tools": [
        "Docker via Makefile"
      ]
    }
  ],
  // Habilita a compilação automática ao salvar o arquivo
  "latex-workshop.latex.autoBuild.run": "onSave",
  // Configurações para melhorar o leitor de PDF embutido
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true
}
